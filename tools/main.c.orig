/* USER CODE BEGIN 4 */




void move_motor(uint32_t target_height)
{
    uint32_t total_pulses;
    uint32_t travel_pulses;

    uint32_t accel_pulses;
    uint32_t decel_pulses;
    uint32_t cruise_pulses;

    uint32_t peak_speed;


    /* Convert target height from mm to pulses */

    total_pulses = target_height * PULSES_PER_MM;


    /*
     * Target must be greater than the homing offset.
     */

    if (total_pulses <= OFFSET)
    {
        return;
    }


    travel_pulses = total_pulses - OFFSET;

//    travel_pulses = total_pulses;


    accel_pulses = calc_accel_pulses();
    decel_pulses = calc_decel_pulses();


    if (travel_pulses >= (accel_pulses + decel_pulses))
    {
        /*
         * TRAPEZOIDAL PROFILE
         */

        cruise_pulses = travel_pulses - accel_pulses - decel_pulses;

        /* PHASE 0: GO TO HOME POSITION */

//        move_to_home();


        /* PHASE 1: ACCELERATE */

        accelerate_motor(
                accel_pulses,
                START_SPEED,
                MAX_SPEED,
                ACCELERATION
        );


        /* PHASE 2: CONSTANT SPEED */

        cruise_motor(
                cruise_pulses,
                MAX_SPEED
        );


        /* PHASE 3: DECELERATE */

        decelerate_motor(
                decel_pulses,
                MAX_SPEED,
                STOP_SPEED,
                DECELERATION
        );
    }
    else
    {
        /*
         * TRIANGULAR PROFILE
         *
         * There is not enough distance to reach MAX_SPEED.
         *
         * Calculate the highest speed that can be reached
         * within the available travel distance.
         */

        peak_speed = calc_triangular_peak_speed(travel_pulses);


        /*
         * Calculate how many pulses are used during
         * acceleration to the calculated peak speed.
         *
         * v^2-u^2 = 2as
         *
         */

        accel_pulses = (uint32_t)((((float)peak_speed * peak_speed) - ((float)START_SPEED * START_SPEED)) / (2.0f * ACCELERATION));

        /*
         * Whatever pulses remain are used for deceleration.
         *
         */

        decel_pulses = travel_pulses - accel_pulses;


        /* PHASE 0: GO TO HOME POSITION */

//        move_to_home();


        /* PHASE 1: ACCELERATE TO PEAK SPEED */

        accelerate_motor(
                accel_pulses,
                START_SPEED,
                peak_speed,
                ACCELERATION
        );


        /*
         * PHASE 2:
         *
         * There is NO cruise phase in a triangular profile.
         */


        /* PHASE 3: DECELERATE FROM PEAK SPEED */

        decelerate_motor(
                decel_pulses,
                peak_speed,
                STOP_SPEED,
                DECELERATION
        );
    }
}


void stepper_delay_us(uint16_t us)
{
    uint16_t start = TIM6->CNT;

    while ((uint16_t)(TIM6->CNT - start) < us)
    {
    }
}


uint32_t calc_accel_pulses(void)
{
    float max_speed = MAX_SPEED;
    float start_speed = START_SPEED;
    float acceleration = ACCELERATION;

    float accel_steps;

    accel_steps =
        (
            (max_speed * max_speed)
            -
            (start_speed * start_speed)
        )
        /
        (2.0f * acceleration);

    return (uint32_t)accel_steps;
}


uint32_t calc_decel_pulses(void)
{
    float max_speed = MAX_SPEED;
    float stop_speed = STOP_SPEED;
    float deceleration = DECELERATION;

    float decel_steps;

    decel_steps =
        (
            (max_speed * max_speed)
            -
            (stop_speed * stop_speed)
        )
        /
        (2.0f * deceleration);

    return (uint32_t)decel_steps;
}


/*
 * ============================================================
 * CALCULATE TRIANGULAR PEAK SPEED
 * ============================================================
 *
 * For a triangular profile:
 *
 *      START -> PEAK -> STOP
 *
 * There is no constant-speed section.
 *
 * The total distance is:
 *
 *      N = acceleration distance + deceleration distance
 *
 * Therefore:
 *
 *      N =
 *      (Vp^2 - Vs^2)/(2a)
 *      +
 *      (Vp^2 - Vf^2)/(2d)
 *
 * Solving for Vp:
 *
 *      Vp =
 *
 *      sqrt(
 *
 *          [2N + Vs^2/a + Vf^2/d]
 *          /
 *          [1/a + 1/d]
 *
 *      )
 *
 */

uint32_t calc_triangular_peak_speed(uint32_t travel_pulses)
{
    float N = (float)travel_pulses;

    float start_speed = (float)START_SPEED;
    float stop_speed = (float)STOP_SPEED;

    float acceleration = (float)ACCELERATION;
    float deceleration = (float)DECELERATION;

    float peak_speed;


    peak_speed =
        sqrtf(
            (
                (2.0f * N)
                +
                ((start_speed * start_speed) / acceleration)
                +
                ((stop_speed * stop_speed) / deceleration)
            )
            /
            (
                (1.0f / acceleration)
                +
                (1.0f / deceleration)
            )
        );


    /*
     * Safety limit:
     *
     * The triangular profile should never produce a peak
     * speed greater than MAX_SPEED.
     */

    if (peak_speed > MAX_SPEED)
    {
        peak_speed = MAX_SPEED;
    }


    return (uint32_t)peak_speed;
}


void accelerate_motor(uint32_t accel_pulses,
                       uint32_t start_speed,
                       uint32_t peak_speed,
                       uint32_t acceleration)
{
    uint32_t present_pulse = 0;

    float cur_speed;
    uint32_t delay;


    while (present_pulse < accel_pulses)
    {

        cur_speed =
            sqrtf(
                ((float)start_speed * start_speed)
                +
                (2.0f * acceleration * present_pulse)
            );


        /*
         * Do not allow the calculated speed to exceed
         * the requested peak speed.
         */

        if (cur_speed > peak_speed)
        {
            cur_speed = peak_speed;
        }


        /*
         * One complete step consists of:
         *
         *      HIGH time + LOW time
         *
         * Therefore divide the period by 2.
         */

        delay = (uint32_t)(1000000.0f / (2.0f * cur_speed));
        step_both_motors(delay);
        present_pulse++;
    }
}

void cruise_motor(uint32_t cruise_pulses,
                  uint32_t speed)
{
    uint32_t present_pulse;

    uint32_t delay;


    delay =(uint32_t)(1000000.0f / (2.0f * speed));

    for (present_pulse = 0; present_pulse < cruise_pulses; present_pulse++)
    {
    	step_both_motors(delay);
    }
}

void decelerate_motor(uint32_t decel_pulses,
                      uint32_t peak_speed,
                      uint32_t stop_speed,
                      uint32_t deceleration)
{
    uint32_t present_pulse = 0;

    float cur_speed;
    uint32_t delay;


    while (present_pulse < decel_pulses)
    {
        cur_speed = sqrtf(((float)peak_speed * peak_speed) - (2.0f * deceleration * present_pulse));

        /*
         * Prevent the calculated speed from dropping below
         * the required stop speed.
         */

        if (cur_speed < stop_speed)
        {
            cur_speed = stop_speed;
        }


        delay = (uint32_t)(1000000.0f / (2.0f * cur_speed));
        step_both_motors(delay);
        present_pulse++;
    }
}


/*
 * MOVE TO HOME
 */

void move_to_home(void)
{
    uint32_t delay = 1000;
    uint32_t home_steps = 0;

    /* Clear previous home status */
    home_reached_1 = 0;
    home_reached_2 = 0;

    /* Check if already at home */
    if (HAL_GPIO_ReadPin(LIMIT_1_GPIO_Port, LIMIT_1_Pin) == GPIO_PIN_RESET)
    {
        home_reached_1 = 1;
    }

    if (HAL_GPIO_ReadPin(LIMIT_2_GPIO_Port, LIMIT_2_Pin) == GPIO_PIN_RESET)
    {
        home_reached_2 = 1;
    }

    /* Set direction toward home */
    HAL_GPIO_WritePin(STEP_DIR_1_GPIO_Port, STEP_DIR_1_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(STEP_DIR_2_GPIO_Port, STEP_DIR_2_Pin, GPIO_PIN_RESET);

    while ((!home_reached_1 || !home_reached_2 ) && home_steps < MAX_HOME_STEPS)
    {
        if (!home_reached_1)
        {
            step_single_motor(MOTOR1, delay);
        }

        if (!home_reached_2)
        {
            step_single_motor(MOTOR2, delay);
        }

        home_steps++;
    }
}


void step_single_motor(uint8_t motor,
				uint32_t delay){

	if(motor == MOTOR1){
        HAL_GPIO_WritePin(STEP_PULSE_1_GPIO_Port,STEP_PULSE_1_Pin,GPIO_PIN_SET);
        stepper_delay_us(delay);
        HAL_GPIO_WritePin(STEP_PULSE_1_GPIO_Port,STEP_PULSE_1_Pin,GPIO_PIN_RESET);
        stepper_delay_us(delay);
	}

	if(motor == MOTOR2){
        HAL_GPIO_WritePin(STEP_PULSE_2_GPIO_Port,STEP_PULSE_2_Pin,GPIO_PIN_SET);
        stepper_delay_us(delay);
        HAL_GPIO_WritePin(STEP_PULSE_2_GPIO_Port,STEP_PULSE_2_Pin,GPIO_PIN_RESET);
        stepper_delay_us(delay);
	}
}

void step_both_motors(uint32_t delay){
	HAL_GPIO_WritePin(STEP_PULSE_1_GPIO_Port, STEP_PULSE_1_Pin, GPIO_PIN_SET);
	HAL_GPIO_WritePin(STEP_PULSE_2_GPIO_Port, STEP_PULSE_2_Pin, GPIO_PIN_SET);
	stepper_delay_us(delay);
	HAL_GPIO_WritePin(STEP_PULSE_1_GPIO_Port, STEP_PULSE_1_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(STEP_PULSE_2_GPIO_Port, STEP_PULSE_2_Pin, GPIO_PIN_RESET);
	stepper_delay_us(delay);
}
/*
 * LIMIT SWITCH INTERRUPT CALLBACK
 */

void HAL_GPIO_EXTI_Falling_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == LIMIT_1_Pin)
    {
        home_reached_1 = 1;
    }

    if (GPIO_Pin == LIMIT_2_Pin)
    {
        home_reached_2 = 1;
    }

}


