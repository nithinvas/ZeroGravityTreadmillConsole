# TrendMill console settings. Installed to /etc/trendmill/trendmill.env, which
# provision.sh will not overwrite on a later upgrade — this is the one file that
# is yours to edit.
#
# After changing anything here:  sudo systemctl restart trendmill-core

# Where sessions, recordings, calibration and logs are kept.
TRENDMILL_DATA_DIR=/var/lib/trendmill

# The built UI. Set explicitly because the backend runs from a virtualenv, where
# it cannot guess where the release put the files.
TRENDMILL_UI_DIR=/opt/trendmill/current/frontend/dist

# Localhost only: the kiosk is the only client, on this machine. Putting the
# console on the network is a decision with patient data attached, not a default.
TRENDMILL_HOST=127.0.0.1
TRENDMILL_PORT=8080

# usb  — the real load-cell board (normal operation)
# sim  — a simulated board, for testing the appliance with no hardware attached
TRENDMILL_SOURCE=usb

# ble  — the real treadmill over Bluetooth (normal operation)
# sim  — a simulated treadmill, for testing without one
# none — no belt control; speed is typed in by the therapist
TRENDMILL_TREADMILL=ble

# usb  - belt height over the load-cell board's USB link (normal operation,
#        and needs the relay firmware on that board)
# sim  - a simulated mechanism, for trying the controls with no hardware
# none - no height control at all
TRENDMILL_HEIGHT=usb

TRENDMILL_LOG_LEVEL=info

# Anything else to pass to `trendmill serve`. The most useful one here is pinning
# the treadmill in a room with more than one, so the console can never connect to
# the wrong machine. Find the address with: bluetoothctl scan on
# TRENDMILL_EXTRA_ARGS=--treadmill-address AA:BB:CC:DD:EE:FF
TRENDMILL_EXTRA_ARGS=
